# Prompt Enhancer settings (Case Study 4).
# Copy to .env and fill in the keys:  cp .env.example .env
# .env is git-ignored and never copied into the Docker image. In the cloud, set these as
# secrets / environment variables on Cloud Run, Azure Container Apps and AWS ECS instead.
# At least one backend (Gemini, OpenRouter or Vertex AI) must be configured for the app to answer.

# ---- Gemini (Google AI Studio: https://aistudio.google.com/apikey) ----------------------
GEMINI_API_KEY=
# One model id, or a comma-separated list tried in order (rotates when one is rate-limited).
GEMINI_MODEL=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-2.5-flash
# none | minimal | low | medium | high  (blank = don't send a thinking budget)
GEMINI_REASONING_EFFORT=low
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ---- OpenRouter (https://openrouter.ai/keys) ----------------------------------------------
OPENROUTER_API_KEY=
# e.g. a free model id such as <provider>/<model>:free
OPENROUTER_MODEL=
# OpenRouter's reasoning control; "none" turns reasoning off (blank = don't send it)
OPENROUTER_REASONING_EFFORT=none
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- Vertex AI (Google Cloud; extra credit) -----------------------------------------------
# No API key: Vertex uses a Google identity. On Cloud Run that's the service's own account (ADC).
# Elsewhere, either point GOOGLE_APPLICATION_CREDENTIALS at a service-account key file (local), or
# pass the key's JSON in VERTEX_SA_KEY_JSON (Azure/AWS secret). Keep key files outside the repo.
VERTEX_PROJECT=
# One model id, or a comma-separated list tried in order.
VERTEX_MODEL=gemini-3.5-flash-lite,gemini-3.5-flash
# minimal | low | medium | high  (blank = don't send it). Thinking tokens count against the output cap.
VERTEX_THINKING_LEVEL=minimal
# VERTEX_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/home/<you>/.config/g25/vertex-sa-key.json
# VERTEX_SA_KEY_JSON=

# ---- App ----------------------------------------------------------------------------------
# Seconds before a backend call gives up and fails over to the next backend.
API_TIMEOUT_S=20
# Cost guard: upper limit on output tokens per request (the Short/Medium/Long presets use 256/512/1024).
MAX_OUTPUT_TOKENS=1024
LOG_LEVEL=INFO
# HOST and PORT default to 0.0.0.0:7860. Don't set PORT on Cloud Run: it injects its own (8080).
# Azure Container Apps and AWS ECS use the default 7860.
# HOST=0.0.0.0
# PORT=7860
